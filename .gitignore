# =============================================================================
#  Echoflow — Comprehensive .gitignore
#  Ensures the project is fully modular and works on any system out of the box.
# =============================================================================


# =============================================================================
# 1. RUNTIME & WORKSPACE DATA
# =============================================================================
# Job artifacts: video frames, audio chunks, JSON checkpoints, temp renders
workspace/jobs/*
workspace/inbox/*
workspace/cache/*

# Preserve directory structure for fresh clones
!workspace/jobs/.gitkeep
!workspace/inbox/.gitkeep
!workspace/cache/.gitkeep

# Local cache (HuggingFace tokens, agent harnesses, xet, locks)
local_cache/


# =============================================================================
# 2. PYTHON ENVIRONMENTS & CACHES
# =============================================================================
# Multi-environment directory (env_core, env_tts, etc.)
.envs/
.venv/
venv/
env/
.virtualenv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Python distribution / packaging
*.egg-info/
*.egg
dist/
*.whl
.Python
pip-log.txt
pip-delete-this-directory.txt

# Python environment files
.env
.env.local
.env.*.local

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/


# =============================================================================
# 3. AI MODELS & BINARY WEIGHTS (Too large for Git)
# =============================================================================
# Model weight files (any framework)
*.onnx
*.pt
*.pth
*.bin
*.safetensors
*.h5
*.hdf5
*.ckpt
*.task
*.tflite
*.pb

# Downloaded model directories
models/whisper-small/
models/nllb-200-distilled-600M/
models/offline_mms_model/
models/offline_openvoice/
models/offline_pyannote_model/
models/pyannote_segmentation/
models/wav2lip-onnx-256/
models/indictrans2-en-indic-1B/
models/indictrans2-indic-en-1B/
models/indictrans2-indic-indic-1B/
models/whisper-medium/

# Keep only the registry config (auto-generated, but useful for reference)
!models/registry.json

# Dynamically cloned repos
wav2lip-onnx-256/


# =============================================================================
# 4. FFMPEG & BINARY TOOLS
# =============================================================================
bin/ffmpeg*
bin/ffprobe*
bin/*.exe
bin/*.zip
bin/*.tar.*
bin/*.7z

# Keep directory structure
!bin/.gitkeep


# =============================================================================
# 5. GO BUILD ARTIFACTS
# =============================================================================
# Compiled binaries
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out

# Go workspace & debug
go.work
go.work.sum
vendor/
*.prof
*.pprof
*.trace
debug
debug.test
cpu.prof
mem.prof


# =============================================================================
# 6. WAILS & FRONTEND BUILD ARTIFACTS
# =============================================================================
# Production build output
build/bin/
build/obj/

# Frontend compiled assets & dependencies
frontend/dist/
frontend/node_modules/
frontend/.cache/
frontend/.parcel-cache/

# Package manager files
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnp.*
.yarn/


# =============================================================================
# 7. IDE & EDITOR SETTINGS
# =============================================================================
# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains (GoLand, PyCharm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
tags

# Emacs
*~
\#*\#
.#*
*.elc

# Fleet
.fleet/


# =============================================================================
# 8. AI CODING AGENTS & ASSISTANTS
# =============================================================================
# Antigravity / Gemini
.agents/
.gemini/

# Cursor
.cursor/
.cursorignore
.cursorindexingignore

# GitHub Copilot
.copilot/

# Claude / Anthropic
.claude/
CLAUDE.md

# Cline
.cline/
.clinerules
.clineignore

# Windsurf
.windsurf/
.windsurfrules

# Aider
.aider*

# Augment
.augment/

# Generic agent files
.ai/
.codex/


# =============================================================================
# 9. OS-SPECIFIC FILES
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
[Dd]esktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# =============================================================================
# 10. LOGS, TEMP FILES & MISCELLANEOUS
# =============================================================================
# Log files
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temp files
*.tmp
*.temp
*.bak
*.backup
*.orig
*.swp

# Archives (shouldn't be committed)
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z

# Database files
*.db
*.sqlite
*.sqlite3

# Secrets & credentials (NEVER commit)
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/
credentials/
.secrets
*.secret

# HuggingFace tokens
.huggingface/
hf_token*
benchmark
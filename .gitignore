# ==========================================
# 1. EcoFlow Dynamic Workspaces
# ==========================================
# Ignore all heavy video frames, chunks, JSON checkpoints, and SQLite caches
workspace/jobs/*
workspace/inbox/*
workspace/cache/*

# Keep the directory structure intact for new clones
!workspace/jobs/.gitkeep
!workspace/inbox/.gitkeep
!workspace/cache/.gitkeep

# ==========================================
# 2. Python Environments & Caches
# ==========================================
# 🛡️ NEW: Ignore the multi-environment directory
.envs/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env

# ==========================================
# 3. AI Models & Submodules (Too large for Git)
# ==========================================
# Ignore heavy weights and HF snapshots. Commit only the registry config.
models/*.onnx
models/*.task
models/*.pt
models/*.bin
models/whisper-small/
models/nllb-200-distilled-600M/
models/offline_mms_model/
models/offline_openvoice/
models/offline_pyannote_model/
models/pyannote_segmentation/
!models/registry.json

# 🛡️ NEW: Ignore dynamically cloned repos and binary files
wav2lip-onnx-256/
bin/*.exe
bin/*.zip

# ==========================================
# 4. Wails / Go / Frontend Build Artifacts
# ==========================================
build/bin/
build/obj/
frontend/dist/
frontend/node_modules/
*.exe

# ==========================================
# 5. OS & IDE Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/